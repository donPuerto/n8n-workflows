    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  \n  const utcTime = item.json.created_time;\n\n  // Convert to Brisbane time and format 24hr HH:mm:ss\n  const brisbaneTime = new Date(utcTime).toLocaleTimeString('en-AU', {\n    timeZone: 'Australia/Brisbane',\n    hour12: false,\n    hour: '2-digit',\n    minute: '2-digit',\n    second: '2-digit'\n  });\n\n  return {\n    json: {\n      ...item.json,\n      created_time_brisbane: brisbaneTime\n    }\n  };\n});"
      },
