    {
      "parameters": {
        "jsCode": "const leads = items[0].json.data ?? [];\n\nfunction flatten(lead) {\n  const out = { lead_id: lead.id, created_time: lead.created_time };\n  for (const f of (lead.field_data ?? [])) {\n    out[f.name] = (f.values && f.values[0]) ? f.values[0] : null;\n  }\n  return out;\n}\n\nreturn leads.map(l => ({ json: flatten(l) }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
