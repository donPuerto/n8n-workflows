      "parameters": {
        "jsCode": "const workflows = $input.first().json;\nconst data = Array.isArray(workflows) ? workflows : (workflows.data || []);\nconst sorted = [...data].sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt));\nreturn sorted.slice(0, 10).map(wf => ({\n  json: {\n    id: wf.id,\n    name: wf.name,\n    active: wf.active,\n    nodeCount: wf.nodeCount,\n    updatedAt: wf.updatedAt\n  }\n}));"
