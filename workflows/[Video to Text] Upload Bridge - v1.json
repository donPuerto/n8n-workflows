  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-to-text-upload",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "n1",
      "name": "Webhook Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        160,
        304
      ],
      "webhookId": "e08a7478-12d9-4b95-b3e6-9825f86086b8",
      "credentials": {
        "httpHeaderAuth": {
          "id": "aXsApdZEwxno7Tkr",
          "name": "Video to Text API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const src = $input.first().json?.body ?? $input.first().json ?? {};\nconst fileName = (src.file_name || 'upload.bin').toString();\nconst mimeType = (src.mime_type || 'application/octet-stream').toString();\nconst base64 = (src.file_base64 || '').toString().trim();\nif (!base64) throw new Error('file_base64 is required');\nconst folderId = (src.folder_id || '').toString().trim();\nreturn [{\n  json: { file_name: fileName, mime_type: mimeType, folder_id: folderId },\n  binary: { fileData: { data: base64, mimeType, fileName } }\n}];"
      },
      "id": "n2",
      "name": "Normalize Upload Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        304
      ]
    },
    {
      "parameters": {
        "inputDataFieldName": "fileData",
        "name": "={{ $json.file_name }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.folder_id }}"
        },
        "options": {
          "simplifyOutput": true
        }
      },
      "id": "n3",
      "name": "Google Drive Upload",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        640,
        304
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YO4qnGhKlEgotzkB",
          "name": "DP: Google Drive Account"
        }
      }
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ (() => { const id = $json.id || $json.fileId || ''; const web = $json.webViewLink || $json.webContentLink || ''; const folder = $('Normalize Upload Payload').first().json.folder_id || ''; return JSON.stringify({ drive_file_id: id, drive_web_view_link: web, source_url: web, drive_folder_id: folder }); })() }}",
        "options": {}
      },
      "id": "n4",
      "name": "Set Upload Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
