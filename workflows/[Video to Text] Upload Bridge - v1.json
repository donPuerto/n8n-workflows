          "id": "aXsApdZEwxno7Tkr",
          "name": "Video to Text API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const src = $input.first().json?.body ?? $input.first().json ?? {};\nconst driveFileId = (src.drive_file_id || '').toString().trim();\nif (!driveFileId) throw new Error('drive_file_id is required');\nreturn [{ json: { drive_file_id: driveFileId } }];"
      },
      "id": "n6",
      "name": "Normalize Delete Payload",
