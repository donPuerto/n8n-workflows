    {
      "id": "41e8e414-6ca5-4dcc-9c6c-9525f813c898",
      "name": "Extract Procore ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "\nconst notes = $input.first().json.notes || '';\nconst match = notes.match(/Procore Punch Item ID: (\\d+)/);\nconst punchItemId = match ? match[1] : null;\nconst completed = $input.first().json.completed;\nconst status = completed ? 'closed' : 'initiated';\n\nreturn [{\n  json: {\n    punch_item_id: punchItemId,\n    asana_task_gid: $input.first().json.gid,\n    title: $input.first().json.name.replace('[Procore] ', ''),\n    notes: $input.first().json.notes,\n    due_date: $input.first().json.due_on,\n    status: status,\n    completed: completed\n  }\n}];\n      "
      }
    },
    {
      "id": "db168691-a63c-4cab-a042-2c110e611628",
