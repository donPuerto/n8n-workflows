    {
      "id": "05715676-ec52-4341-9115-caff5da0155c",
      "name": "Find Stale",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        272
      ],
      "parameters": {
        "jsCode": "const live = new Set((($('Collect Live Names').first().json.liveNames) || []));\nconst out = [];\nfor (const it of $input.all()) {\n  const f = it.json || {};\n  const nm = f.name || '';\n  if (!/\\.json$/.test(nm)) continue;\n  const base = nm.replace(/\\.json$/, '');\n  const path = f.path || ('workflows/' + nm);\n  if (base && !live.has(base)) out.push({ json: { path: path, name: base } });\n}\nreturn out;"
      }
    },
