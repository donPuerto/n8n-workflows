      "id": "25656065-48cb-4b66-8e42-528bfbfcbb6f",
      "name": "Build File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const wf = it.json;\n  const name = wf.name || 'workflow';\n  const safeName = name.replace(/[<>:\"/\\\\|?*]+/g, '').trim();\n  const content = JSON.stringify(wf, null, 2);\n  out.push({ json: { name: name, safeName: safeName, path: 'workflows/' + safeName + '.json', content: content, workflowId: wf.id } });\n}\nreturn out;"
      }
    },
