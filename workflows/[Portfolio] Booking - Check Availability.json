      "id": "gcal-events",
      "name": "Get Calendar Events",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "1TXl73FCExI5p2lV",
          "name": "DP: Google Calendar Account"
        }
      }
