    {
      "parameters": {
        "jsCode": "// Get normalized input from earlier node\nconst normalized = $('Normalize Dates').first().json;\nconst requestedStart = new Date(normalized.requested_start);\nconst durationMin = Number(normalized.duration_min) || 60;\nconst requestedEnd = normalized.requested_end \n  ? new Date(normalized.requested_end)\n  : new Date(requestedStart.getTime() + durationMin * 60000);\n\n// Get all calendar events - handle empty input gracefully\nlet events = [];\ntry {\n  const rawItems = $input.all().map(i => i.json);\n  events = rawItems.filter(e => e && (e.start || e.summary));\n} catch (err) {\n  events = [];\n}\n\n// Check if any event overlaps with requested time\nconst conflict = events.find(event => {\n  let eStart, eEnd;\n  if (event.start?.dateTime) {\n    eStart = new Date(event.start.dateTime);\n    eEnd = new Date(event.end.dateTime);\n  } else if (event.start?.date) {\n    // All-day events: treat as full day\n    eStart = new Date(event.start.date + 'T00:00:00');\n    eEnd = new Date(event.end.date + 'T00:00:00');\n  } else {\n    return false;\n  }\n  return requestedStart < eEnd && requestedEnd > eStart;\n});\n\nconst available = !conflict;\n\n// If unavailable, find next 3 open slots (working hours 8:00-17:00)\nlet alternatives = [];\nif (!available) {\n  const workStart = 8, workEnd = 17;\n  let candidate = new Date(requestedStart);\n  candidate.setMinutes(0, 0, 0);\n  if (candidate.getHours() < workStart) candidate.setHours(workStart);\n\n  for (let attempts = 0; attempts < 30 && alternatives.length < 3; attempts++) {\n    candidate = new Date(candidate.getTime() + 60 * 60000);\n    if (candidate.getHours() >= workEnd) {\n      candidate.setDate(candidate.getDate() + 1);\n      candidate.setHours(workStart, 0, 0, 0);\n      while (candidate.getDay() === 0 || candidate.getDay() === 6) {\n        candidate.setDate(candidate.getDate() + 1);\n      }\n    }\n    const candEnd = new Date(candidate.getTime() + durationMin * 60000);\n    const hasConflict = events.some(event => {\n      let eStart, eEnd;\n      if (event.start?.dateTime) {\n        eStart = new Date(event.start.dateTime);\n        eEnd = new Date(event.end.dateTime);\n      } else if (event.start?.date) {\n        eStart = new Date(event.start.date + 'T00:00:00');\n        eEnd = new Date(event.end.date + 'T00:00:00');\n      } else {\n        return false;\n      }\n      return candidate < eEnd && candEnd > eStart;\n    });\n    if (!hasConflict) {\n      alternatives.push({\n        start: candidate.toISOString(),\n        end: candEnd.toISOString()\n      });\n    }\n  }\n}\n\nreturn [{\n  json: {\n    success: true,\n    available,\n    events_found: events.length,\n    calendar_id: normalized.calendar_id,\n    requested_start: requestedStart.toISOString(),\n    requested_end: requestedEnd.toISOString(),\n    timezone: normalized.timezone,\n    alternatives\n  }\n}];"
      },
