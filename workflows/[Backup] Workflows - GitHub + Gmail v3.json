    {
      "id": "25656065-48cb-4b66-8e42-528bfbfcbb6f",
      "name": "Build File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const wf = it.json;\n  const name = wf.name || 'workflow';\n  const safeName = name.replace(/[<>:\"/\\\\|?*]+/g, '').trim();\n  const jsonStr = JSON.stringify(wf, null, 2);\n  const base64 = Buffer.from(jsonStr, 'utf8').toString('base64');\n  out.push({\n    json: { name: name, safeName: safeName, path: 'workflows/' + safeName + '.json', workflowId: wf.id },\n    binary: { data: { data: base64, mimeType: 'application/json', fileName: safeName + '.json' } }\n  });\n}\nreturn out;"
      }
    },
