        "parameters": {
          "jsCode": "const statusCode = $json.statusCode;\nconst body = $json.body || $json;\n\nif (statusCode >= 200 && statusCode < 300 && body.id) {\n  return [{\n    result: \"success\",\n    status_code: statusCode,\n    fb_post_id: body.id\n  }];\n}\n\nreturn [{\n  result: \"error\",\n  status_code: statusCode,\n  error_reason: body.error?.message || \"Unknown error\",\n  error_type: body.error?.type || null,\n  error_code: body.error?.code || null\n}];"
