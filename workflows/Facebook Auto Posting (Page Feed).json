      {
        "parameters": {
          "jsCode": "// Only pass through rows where status is \"draft\".\n// Everything else returns [] (dropped).\n\nconst id = ($json.id ?? '').toString().trim();\nconst message_text = ($json.message_text ?? '').toString().trim();\nconst schedule_at = ($json.schedule_at ?? '').toString().trim();\n\nconst rawStatus =\n  $json[\"status (draft / scheduled / posted / error)\"] ??\n  $json.status ??\n  '';\n\nconst status = rawStatus.toString().trim().toLowerCase();\n\n// ✅ Filter: ONLY allow draft rows to continue\nif (status !== 'draft') {\n  return [];\n}\n\n// Brisbane timeline (now)\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Australia/Brisbane' }));\nconst pad = (n) => String(n).padStart(2, '0');\nconst timeline =\n  `${pad(now.getDate())}/${pad(now.getMonth() + 1)}/${now.getFullYear()} ` +\n  `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;\n\n// validations\nconst hasMessage = message_text.length > 0;\n\n// Expect dd/mm/yy or dd/mm/yyyy (date-only)\nlet scheduleYMD = '';\nconst m = schedule_at.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{2}|\\d{4})$/);\n\nif (m) {\n  const dd = String(parseInt(m[1], 10)).padStart(2, '0');\n  const mm = String(parseInt(m[2], 10)).padStart(2, '0');\n  let yyyy = parseInt(m[3], 10);\n  if (yyyy < 100) yyyy += 2000;\n  scheduleYMD = `${yyyy}${mm}${dd}`;\n}\n\nconst todayBrisbane = new Date().toLocaleDateString('en-CA', {\n  timeZone: 'Australia/Brisbane'\n}).replace(/-/g, '');\n\n// ready_to_post (date-only): schedule <= today in Brisbane AND message exists\nconst ready_to_post =\n  hasMessage &&\n  scheduleYMD !== '' &&\n  scheduleYMD <= todayBrisbane;\n\nreturn [{\n  id,\n  timeline,\n  message_text,\n  status,        // will always be \"draft\" here\n  schedule_at,\n  ready_to_post,\n}];"
        },
