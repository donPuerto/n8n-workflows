      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rest.gohighlevel.com/v1/contacts/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "firstName",
              "value": "={{ $json.body.name.split(' ')[0] }}"
            },
            {
              "name": "lastName",
              "value": "={{ $json.body.name.split(' ').slice(1).join(' ') }}"
            },
            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "phone",
              "value": "={{ $json.body.phone }}"
            },
            {
              "name": "companyName",
              "value": "={{ $json.body.company }}"
            },
            {
              "name": "source",
              "value": "={{ $json.body.source }}"
            }
          ]
        },
        "options": {}
      },
      "id": "8bf035de-23a9-4c5c-8eaf-e57c06be1df5",
      "name": "Step 1 - Add to GHL CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        144
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "3ri6jVKMrdN1vNPy",
          "name": "WR: Facebook Header Auth Account"
        }
      },
      "notes": "Requires: GoHighLevel API Key credential (Authorization: Bearer YOUR_GHL_API_KEY)"
    },
    {
      "parameters": {
        "subject": "Welcome! We received your inquiry",
        "message": "=<html>\n<body style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n  <h2 style=\"color: #2c3e50;\">Hi {{ $('Webhook - Lead Form').item.json.body.name }},</h2>\n  <p>Thank you for reaching out! We've received your inquiry and a member of our team will follow up with you within 24 hours.</p>\n  <p><strong>Your submission details:</strong></p>\n  <ul>\n    <li>Name: {{ $('Webhook - Lead Form').item.json.body.name }}</li>\n    <li>Company: {{ $('Webhook - Lead Form').item.json.body.company }}</li>\n    <li>Source: {{ $('Webhook - Lead Form').item.json.body.source }}</li>\n  </ul>\n  <p>In the meantime, feel free to reply to this email if you have any questions.</p>\n  <p>Best regards,<br>The Sales Team</p>\n</body>\n</html>",
        "options": {}
      },
      "id": "667a125d-b962-442c-ba24-3cd31a55502f",
      "name": "Step 2 - Send Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        240,
        144
      ],
      "webhookId": "9c2e56f2-e8b1-40e7-a031-27c19f748837",
      "credentials": {
        "gmailOAuth2": {
          "id": "RhxDT8POCR7oU2yl",
          "name": "DP: Gmail Account"
        }
      },
      "notes": "Requires: Gmail OAuth2 credential. Change fromEmail to your email address."
    },
    {
      "parameters": {
