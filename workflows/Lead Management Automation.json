        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "=Follow up with {{ $('Webhook - Lead Form').item.json.body.name }} from {{ $('Webhook - Lead Form').item.json.body.company }}"
            },
            {
              "name": "body",
              "value": "=New lead received via {{ $('Webhook - Lead Form').item.json.body.source }}. Contact: {{ $('Webhook - Lead Form').item.json.body.email }} | {{ $('Webhook - Lead Form').item.json.body.phone }}. Follow up required within 24 hours."
            },
            {
              "name": "dueDate",
              "value": "={{ new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "name": "contactId",
              "value": "={{ $('Step 1 - Add to GHL CRM').item.json.contact.id }}"
            },
            {
              "name": "assignedTo",
              "value": "SALES_TEAM_USER_ID"
            }
          ]
        },
