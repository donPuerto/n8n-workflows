    {
      "id": "aggregate-1120",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        100
      ],
      "parameters": {
        "jsCode": "\nconst rows = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const c = j.content || j;\n  const url = c.html_url || j.html_url || '';\n  const name = (c.name || j.name || '').replace(/\\.json$/, '') || 'unknown';\n  if (url) rows.push({ name, url });\n}\nconst seen = new Set(); const uniq = [];\nfor (const r of rows) { if (!seen.has(r.url)) { seen.add(r.url); uniq.push(r); } }\nuniq.sort((a,b)=>a.name.localeCompare(b.name));\nconst list = uniq.map(r => '<li><a href=\"'+r.url+'\">'+r.name+'</a></li>').join('');\nconst html = '<div style=\"font-family:Arial,sans-serif;max-width:640px\"><h2>n8n Backup to GitHub</h2>'\n  + '<p>'+uniq.length+' workflow(s) backed up to <a href=\"https://github.com/donPuerto/n8n-workflows/tree/main/workflows\">donPuerto/n8n-workflows</a>.</p>'\n  + '<ul>'+list+'</ul></div>';\nreturn [{ json: { subject: 'n8n Backup: ' + uniq.length + ' workflows -> GitHub', html, count: uniq.length } }];\n"
      }
