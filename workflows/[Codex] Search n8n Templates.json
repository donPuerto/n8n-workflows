            {
              "name": "rows",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "id": "code-tmpl",
      "name": "Format Templates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst templates = data.workflows || data.items || [];\nreturn templates.map(t => ({\n  json: {\n    id: t.id,\n    name: t.name,\n    description: t.description,\n    nodes: (t.workflow?.nodes || []).map(n => n.type),\n    views: t.totalViews\n  }\n}));"
      }
    }
