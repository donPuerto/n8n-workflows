        480,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.n8n.io/templates/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "search",
              "value": "={{ $json.query || $json.body?.query || 'automation' }}"
